function S=behavior_record_ready_summary(V)
% Account for every real record-ready event without changing any RAW/code.
    assert(isstruct(V)&&isscalar(V)&&isequal(sort(fieldnames(V)),sort({'observed_raw';'raw';'readiness_boundary'})), ...
        'SAR20:readySummary','Use only public RAW rows and boundary.');
    raw=V.observed_raw;assert(isa(raw,'double')&&isreal(raw)&&size(raw,2)==6, ...
        'SAR20:readySummary','Expected actual public RAW6 record-ready rows.');
    flag=raw(:,6);bad=(flag~=1);zero=(flag==0);unknown=~ismember(flag,[0 1]);
    ids=raw(bad,4);epochs=raw(bad,5);finiteIds=ids(isfinite(ids));range=[];
    if ~isempty(finiteIds),range=[min(finiteIds) max(finiteIds)];end
    S=struct('readiness_boundary',V.readiness_boundary,'all_ready_count',size(raw,1), ...
        'valid1_count',nnz(flag==1),'invalid_count',nnz(bad), ...
        'valid0_count',nnz(zero),'unknown_valid_count',nnz(unknown), ...
        'invalid_ids',ids(:).','invalid_epochs',epochs(:).','invalid_finite_id_range',range, ...
        'invalid_nonfinite_id_count',nnz(~isfinite(ids)), ...
        'selected_window_count',size(V.raw,1),'selected_invalid_count',nnz(V.raw(:,6)~=1), ...
        'scope','all actual ready rows; no filtering or zero-fill');
end
