function P=behavior_training_configuration(P)
%BEHAVIOR_TRAINING_CONFIGURATION v1 2026-10-27. Prepare public-only CalCfg.
% Model-level projection selects explicit public leaves; the fitter never sees P.
% Off is the default for old configurations. An enabled external reference must
% be declared separately before the run; this function NEVER copies P.input.
    if ~isfield(P,'training')
        ref=struct('enabled',false,'source','declared_external_reference', ...
            'provenance','Inactive external reference; no measured data', ...
            'sample_period_s',P.Ts_s,'epoch',P.epoch,'first_id',P.first_id,'records',P.N, ...
            'offset_v',0,'amplitude_v',0,'frequency_hz',0,'phase_rad',0);
        P.training=struct('enabled',false,'reference',ref);
    end
    assert(isstruct(P.training)&&isscalar(P.training)&& ...
        isfield(P.training,'enabled')&&isfield(P.training,'reference')&& ...
        isscalar(P.training.enabled)&&ismember(P.training.enabled,[0 1]), ...
        'calConfig:mode','Supply enabled plus explicit external reference declaration.');
    ref=P.training.reference;on=logical(P.training.enabled);
    assert(~on||ref.enabled,'calConfig:referenceRequired','Training needs an enabled external reference.');
    if on||ref.enabled
        assert(ref.sample_period_s==P.Ts_s&&ref.epoch==P.epoch&& ...
            ref.first_id==P.first_id&&ref.records==P.N&&P.digital.fsr_diff_v==8.192, ...
            'calConfig:referenceJoin','Training source window/epoch/nominal aperture must match the declared public record.');
    else
        ref.sample_period_s=P.Ts_s;ref.epoch=P.epoch;
        ref.first_id=P.first_id;ref.records=P.N;
    end
    P.training.reference=ref;
    mapping=pick(P.front,{'plan_rows','pool_seed','dem_enabled','dem_seed','dither_enabled', ...
        'dither_seed','dither_input_amplitude_v','vref_v'});
    digital=pick(P.digital,{'vref_v','fsr_diff_v','ra_gain','d2_weights_ra_v','d2_offset_ra_v', ...
        'tracking_step_ra_v','dither_enabled','dither_seed','dither_amplitude_v', ...
        'az_mode','tracking_mode','calibration_mode'});
    pub=struct('mapping',mapping,'digital',digital,'control',struct('sample_period_s',P.Ts_s));
    cfg=public_calibration_config(pub);
    limits=struct('relative_singular_cutoff',1e-10,'maximum_condition_number',1e8,'training_rms_limit_v',7.8125e-6);
    P.cal_cfg=struct('enabled',on,'N_train',P.N,'first_id',P.first_id,'epoch',P.epoch, ...
        'public_cfg',cfg,'reference_provenance',ref.provenance,'thresholds',limits);
    P.training.log_points=1;if ref.enabled,P.training.log_points=Inf;end
    P.training.snapshot_width=1;if on,P.training.snapshot_width=2624;end
    if ~isfield(P,'frozen'),P.frozen=struct('enabled',false,'cache',[]);end
    assert(isstruct(P.frozen)&&isscalar(P.frozen)&&isfield(P.frozen,'enabled')&& ...
        isscalar(P.frozen.enabled)&&ismember(P.frozen.enabled,[0 1])&&isfield(P.frozen,'cache'), ...
        'calConfig:frozen','Use an explicit frozen-mode flag and cache.');
    % The registered684 h basis is STATIC: cfg17 has no DAC settling/history
    % terms. Never let a finite-DAC branch silently reuse/refit that profile.
    assert(all(P.front.tau_dac_s(:)==0)||(~on&&~P.frozen.enabled), ...
        'calConfig:finiteDACCalibration', ...
        'Finite DAC settling requires training/frozen OFF; the static tau_dac=0 calibration profile is not transferable.');
    P.frozen.log_points=1;
    if P.frozen.enabled
        assert(~on,'calConfig:separation','Frozen evaluation cannot collect/refit training rows.');
        C=P.frozen.cache;
        assert(strcmp(C.schema,'sar20-public-frozen-cache/v2')&& ...
            isequaln(C.public_cfg,cfg)&&strcmp(C.lifecycle,'frozen_for_holdout')&& ...
            strcmp(C.acceptance,'NOT_ACCEPTED'),'calConfig:frozenJoin', ...
            'Frozen public configuration/lifecycle differs; do not silently reconfigure coefficients.');
        P.frozen.log_points=Inf;
    end
end
function out=pick(in,names)
    out=struct();for k=1:numel(names),out.(names{k})=in.(names{k});end
end
