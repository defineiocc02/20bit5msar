function s=behavior_transport_unpack(x,cfg)
%BEHAVIOR_TRANSPORT_UNPACK Fixed x97 order, exact inverse of module pack.
% No hidden state. RX only comes from61:83; TX source tags stay in TX/pending.
    assert(isequaln(cfg,behavior_transport_config()),'transport97:cfg','Fixed public cfg required.');
    assert(isa(x,'double')&&isreal(x)&&isequal(size(x),[97 1])&&all(isfinite(x))&&x(1)==1&&x(61)==1, ...
        'transport97:state','Use initialized finite double97 from public EN prehistory.');
    t=struct('initialized',x(1),'prev_cnv',x(2),'prev_clk',x(3),'prev_en',x(4), ...
        'in_shutdown',logical(x(5)),'epoch',x(6),'reset_time_s',-Inf, ...
        'cnv_id',x(9),'cnv_count',x(10),'slot_time_s',NaN,'slot_target_id',x(13), ...
        'slot_word',x(14),'slot_mode',x(15),'tx_active',logical(x(16)), ...
        'data_bit_index',x(17),'data_bit',x(18),'active_source_epoch',x(19), ...
        'preamble_seen',logical(x(20)),'slot_clock_error',logical(x(21)), ...
        'last_complete_ordinal',x(22),'resync_required',logical(x(23)),'sample_history_next',x(24));
    if x(7),t.reset_time_s=x(8);end
    if x(11),t.slot_time_s=x(12);end
    t.sample_history_id=x(25:28).';t.sample_history_time_s=x(33:36).';
    t.sample_history_time_s(x(29:32)==0)=NaN;
    e=struct('sample_id',-1,'epoch',-1,'commit_time_s',Inf,'word',0,'valid',0);t.cache=repmat(e,1,4);
    for k=1:4
        v=x(36+(k-1)*6+(1:6));ct=Inf;if v(1)>=0&&v(3),ct=v(4);end
        t.cache(k)=struct('sample_id',v(1),'epoch',v(2),'commit_time_s',ct,'word',v(5),'valid',v(6));
    end
    v=x(61:83);r=struct('initialized',v(1),'prev_cnv',v(2),'prev_clk',v(3),'prev_dco',v(4), ...
        'prev_dco_n',v(5),'prev_en',v(6),'in_shutdown',logical(v(7)),'epoch',v(8), ...
        'cnv_id',v(9),'cnv_count',v(10),'last_complete_ordinal',v(11),'resync_required',logical(v(12)), ...
        'slot_time_s',NaN,'slot_mode',v(15),'slot_active',logical(v(16)), ...
        'slot_closed',logical(v(17)),'slot_done',logical(v(18)),'slot_corrupt',logical(v(19)), ...
        'slot_target_id',v(20),'frame_word',v(21),'capture_count',v(22),'preamble_seen',logical(v(23)));
    if v(13),r.slot_time_s=v(14);end
    s=struct('tx',t,'rx',r,'pending_valid',logical(x(84)), ...
        'pending_record',x(85:91),'held_raw6',x(92:97));
end
