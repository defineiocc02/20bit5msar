function behavior_ra_noise_validate_backend(p)
%BEHAVIOR_RA_NOISE_VALIDATE_BACKEND Validate ON OU contract at setup/cold init.
% OFF returns without changing any legacy parameter or numerical operation.
% This isolated candidate supports differential VX output noise only, with
% 0<=sigma_vx_rms<Inf [V], scalar uint64 seed, finite positive UGB/Cf, infinite
% slew, and zero DAC tau. AZ-on and finite-DAC combinations are not qualified.
    assert(isstruct(p)&&isscalar(p)&&isfield(p,'ni')&&isstruct(p.ni)&& ...
        isscalar(p.ni)&&isfield(p.ni,'ra_noise')&&binary(p.ni.ra_noise), ...
        'sar20RA:flag','Backend ra_noise must be one binary flag.');
    if ~logical(p.ni.ra_noise),return;end
    % ON setup must independently reject unknown/missing and unsupported NI;
    % do not rely on a later dt=0 backend_step to discover them.
    allowed={'cap_mismatch','cinc_kick','az','ra_noise','az_noise', ...
        'reference_noise','nonlinear_ra','replica_delay'};
    assert(isequal(sort(fieldnames(p.ni)),sort(allowed(:))), ...
        'sar20RA:niSchema','ON requires the exact known backend NI schema.');
    for k=1:numel(allowed)
        assert(binary(p.ni.(allowed{k})),'sar20RA:niFlag','Invalid backend NI flag %s.',allowed{k});
    end
    for key={'az_noise','reference_noise','nonlinear_ra','replica_delay'}
        assert(~logical(p.ni.(key{1})),'sar20RA:unsupportedNI', ...
            'OU ON does not implement backend %s.',key{1});
    end
    assert(isfield(p,'ra_noise')&&isstruct(p.ra_noise)&&isscalar(p.ra_noise)&& ...
        all(isfield(p.ra_noise,{'schema','sigma_vx_rms','seed_u64'})), ...
        'sar20RA:configuration','ON requires schema, sigma_vx_rms, seed_u64.');
    q=p.ra_noise;
    assert(ischar(q.schema)&&isrow(q.schema)&&strcmp(q.schema,'sar20-ra-ou/v1'), ...
        'sar20RA:schema','Use sar20-ra-ou/v1.');
    assert(isa(q.sigma_vx_rms,'double')&&isreal(q.sigma_vx_rms)&& ...
        isscalar(q.sigma_vx_rms)&&isfinite(q.sigma_vx_rms)&&q.sigma_vx_rms>=0, ...
        'sar20RA:sigma','Output sigma must be a finite nonnegative double V rms.');
    assert(isa(q.seed_u64,'uint64')&&isscalar(q.seed_u64), ...
        'sar20RA:seed','Seed must be one uint64, including sigma=0 or dt=0.');
    assert(isfield(p,'ra')&&isstruct(p.ra)&&isscalar(p.ra)&& ...
        all(isfield(p.ra,{'A0','Cf_f','UGB_hz','slew_v_per_s'})), ...
        'sar20RA:ra','ON requires explicit A0, Cf, UGB and slew.');
    assert(isa(p.ra.A0,'double')&&isreal(p.ra.A0)&&isscalar(p.ra.A0)&& ...
        ~isnan(p.ra.A0)&&p.ra.A0>0,'sar20RA:gain','A0 must be positive finite or +Inf.');
    assert(isa(p.ra.Cf_f,'double')&&isreal(p.ra.Cf_f)&&isscalar(p.ra.Cf_f)&& ...
        isfinite(p.ra.Cf_f)&&p.ra.Cf_f>0&&isa(p.ra.UGB_hz,'double')&& ...
        isreal(p.ra.UGB_hz)&&isscalar(p.ra.UGB_hz)&&isfinite(p.ra.UGB_hz)&&p.ra.UGB_hz>0, ...
        'sar20RA:tau','ON needs finite positive Cf and UGB.');
    denom=2*pi*p.ra.UGB_hz;
    assert(isfinite(denom)&&denom>0&&isfinite(1/denom)&&1/denom>0, ...
        'sar20RA:tau','The minimum possible RA tau must be finite and representably positive.');
    assert(isa(p.ra.slew_v_per_s,'double')&&isreal(p.ra.slew_v_per_s)&& ...
        isscalar(p.ra.slew_v_per_s)&&isinf(p.ra.slew_v_per_s)&&p.ra.slew_v_per_s>0, ...
        'sar20RA:finiteSlew','ON OU requires infinite slew; finite slew is unverified.');
    assert(isfield(p.ni,'az')&&binary(p.ni.az)&&~logical(p.ni.az), ...
        'sar20RA:az','ON OU requires AZ OFF in this unqualified candidate.');
    % Nominal is always used by observe; actual/replica are additionally used
    % when backend cap mismatch selection is enabled. Verify real 7-cap arrays.
    assert(isfield(p,'ct')&&isstruct(p.ct)&&isscalar(p.ct)&& ...
        isfield(p.ct,'replica_enabled')&&binary(p.ct.replica_enabled), ...
        'sar20RA:m8Network','ON requires an explicit CT/replica configuration.');
    networks={'net_nominal'};
    if p.ni.cap_mismatch,networks={'net_nominal','net_actual','net_replica'};end
    for k=1:numel(networks)
        name=networks{k};assert(isfield(p.ct,name)&&isstruct(p.ct.(name))&&isscalar(p.ct.(name)), ...
            'sar20RA:m8Network','Missing selected CT network %s.',name);
        net=p.ct.(name);
        assert(isfield(net,'tracking_count')&&isnumeric(net.tracking_count)&& ...
            isreal(net.tracking_count)&&isscalar(net.tracking_count)&&net.tracking_count==7&& ...
            isfield(net,'track_f')&&isa(net.track_f,'double')&&isreal(net.track_f)&& ...
            isequal(size(net.track_f),[2 7])&&all(isfinite(net.track_f(:))&net.track_f(:)>0), ...
            'sar20RA:m8Network','Selected CT %s requires tracking_count=7 and 2x7 positive tracking caps.',name);
        validate_ct_network(net,name);
    end
    assert(isfield(p.ct,'reference_v')&&isa(p.ct.reference_v,'double')&& ...
        isreal(p.ct.reference_v)&&isscalar(p.ct.reference_v)&&isfinite(p.ct.reference_v)&&p.ct.reference_v>0, ...
        'sar20RA:ctNetwork','CT reference must be positive finite.');
    assert(isfield(p,'dac_coupling')&&isstruct(p.dac_coupling)&& ...
        isscalar(p.dac_coupling)&&isfield(p.dac_coupling,'tau_dac_s'), ...
        'sar20RA:dacBinding','ON OU needs prepared DAC tau binding.');
    t=p.dac_coupling.tau_dac_s;
    assert(isa(t,'double')&&isreal(t)&&numel(t)==18&&all(t(:)==0), ...
        'sar20RA:finiteDAC','ON OU requires all 18 DAC taus zero.');
end

function validate_ct_network(net,name)
% Same two-half split topology consumed by sar20_cdac2_network. A positive
% CINC/bridge and positive physical D2/TA caps are required; dummy/parasitic
% caps may be zero. No PDK or matching claim follows from this structural gate.
    keys={'cinc_f','bridge_f','main_f','sub_f','track_f','dummy_f','parasitic_main_f','parasitic_sub_f'};
    assert(all(isfield(net,keys)),'sar20RA:ctNetwork','Selected CT %s is missing a physical capacitance.',name);
    for k=1:numel(keys)
        v=net.(keys{k});assert(isa(v,'double')&&isreal(v)&&all(isfinite(v(:)))&&all(v(:)>=0), ...
            'sar20RA:ctNetwork','Selected CT %s has invalid %s.',name,keys{k});
    end
    assert(isequal(size(net.cinc_f),[2 1])&&all(net.cinc_f(:)>0)&& ...
        isequal(size(net.bridge_f),[2 1])&&all(net.bridge_f(:)>0)&& ...
        size(net.main_f,1)==2&&size(net.main_f,2)>0&& ...
        size(net.sub_f,1)==2&&size(net.sub_f,2)>0&& ...
        size(net.main_f,2)+size(net.sub_f,2)==12&& ...
        all(net.main_f(:)>0)&&all(net.sub_f(:)>0)&& ...
        isequal(size(net.track_f),[2 7])&&all(net.track_f(:)>0)&& ...
        isequal(size(net.dummy_f),[2 1])&&isequal(size(net.parasitic_main_f),[2 1])&& ...
        isequal(size(net.parasitic_sub_f),[2 1]), ...
        'sar20RA:ctNetwork','Selected CT %s has a disconnected/invalid CINC, bridge, D2 or TA network.',name);
    for side=1:2
        cs=net.cinc_f(side);cb=net.bridge_f(side);
        a=cs+sum(net.main_f(side,:))+cb+net.parasitic_main_f(side);
        b=sum(net.sub_f(side,:))+sum(net.track_f(side,:))+net.dummy_f(side)+cb+net.parasitic_sub_f(side);
        matrix=[a -cb;-cb b];
        assert(all(isfinite(matrix(:)))&&rcond(matrix)>0,'sar20RA:ctNetwork', ...
            'Selected CT %s has singular or nonfinite half-network.',name);
    end
end

function yes=binary(v)
    yes=(isnumeric(v)||islogical(v))&&isreal(v)&&isscalar(v)&& ...
        isfinite(double(v))&&any(double(v)==[0 1]);
end
