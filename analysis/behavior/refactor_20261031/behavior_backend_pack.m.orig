function v=behavior_backend_pack(s)
%BEHAVIOR_BACKEND_PACK Current AZ v2 fixed 48-word UnitDelay layout.
% 1:35 unchanged v1 physics/command prefix; 36 cmd sample_id, 37 cmd epoch;
% 38 AZ valid [0/1], 39 pair_id [integer], 40 epoch [integer], 41 age_s [s],
% 42 write_active [0/1], 43 write_count [integer cumulative],
% 44 last_write_sample_id, 45 last_service_sample_id [integers],
% 46:47 held input-half write-source [V], 48 write_elapsed_s [s].
% RST_SIG clears none of these. Epoch revokes validity/pair/service tags and
% active-window times; analog words3:4 and cumulative write_count are retained.
% No state advancement/RNG. Only first 35 words are legacy-comparable.
    c=s.command;a=s.az;
    v=[s.time_s;s.vx_v;s.az_input_half_v(:);s.ct_reset_vx_v; ...
        s.main_qb_c(:);s.replica_qb_c(:);s.previous_switch_charge_c(:); ...
        c.qres_c;c.ctop_f;c.d2_signs(:);c.ta_signs(:); ...
        double(c.ra_on);double(c.az_on);double(c.reset); ...
        c.sample_id;c.epoch;double(a.valid);a.pair_id;a.epoch;a.age_s; ...
        double(a.write_active);a.write_count;a.last_write_sample_id; ...
        a.last_service_sample_id;a.write_source_half_v(:);a.write_elapsed_s];
    assert(isa(v,'double')&&isreal(v)&&isequal(size(v),[48 1])&&all(isfinite(v)), ...
        'behavior:pack','AZ backend must pack into 48 finite doubles.');
end
