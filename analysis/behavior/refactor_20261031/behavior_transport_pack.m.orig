function x=behavior_transport_pack(s,cfg)
%BEHAVIOR_TRANSPORT_PACK Fixed x97: TX60/RX23/pending8/heldRaw6. No generic pack.
% Numeric UnitDelay owns this state. Invalid protocol times encode finite0+flag.
% TX/RX field order matches the original numeric adapters; cores unchanged.
    assert(isequaln(cfg,behavior_transport_config()),'transport97:cfg','Fixed public cfg required.');
    t=s.tx;r=s.rx;assert(numel(t.cache)==4&&numel(t.sample_history_id)==4,'transport97:shape','TX capacity mismatch.');
    x=zeros(97,1);
    x(1:24)=[t.initialized;t.prev_cnv;t.prev_clk;t.prev_en;double(t.in_shutdown);t.epoch; ...
        double(isfinite(t.reset_time_s));finite(t.reset_time_s);t.cnv_id;t.cnv_count; ...
        double(isfinite(t.slot_time_s));finite(t.slot_time_s);t.slot_target_id;t.slot_word;t.slot_mode; ...
        double(t.tx_active);t.data_bit_index;t.data_bit;t.active_source_epoch;double(t.preamble_seen); ...
        double(t.slot_clock_error);t.last_complete_ordinal;double(t.resync_required);t.sample_history_next];
    x(25:28)=t.sample_history_id(:);x(29:32)=double(isfinite(t.sample_history_time_s(:)));
    x(33:36)=arrayfun(@finite,t.sample_history_time_s(:));
    for k=1:4
        e=t.cache(k);x(36+(k-1)*6+(1:6))=[e.sample_id;e.epoch; ...
            double(e.sample_id>=0&&isfinite(e.commit_time_s));finite(e.commit_time_s);e.word;e.valid];
    end
    x(61:83)=[r.initialized;r.prev_cnv;r.prev_clk;r.prev_dco;r.prev_dco_n;r.prev_en; ...
        double(r.in_shutdown);r.epoch;r.cnv_id;r.cnv_count;r.last_complete_ordinal; ...
        double(r.resync_required);double(isfinite(r.slot_time_s));finite(r.slot_time_s); ...
        r.slot_mode;double(r.slot_active);double(r.slot_closed);double(r.slot_done); ...
        double(r.slot_corrupt);r.slot_target_id;r.frame_word;r.capture_count;double(r.preamble_seen)];
    x(84)=double(s.pending_valid);x(85:91)=s.pending_record(:);x(92:97)=s.held_raw6(:);
    assert(all(isfinite(x)),'transport97:finite','All97 UnitDelay values must be finite.');
end
function v=finite(v)
    if ~isfinite(v),v=0;end
end
