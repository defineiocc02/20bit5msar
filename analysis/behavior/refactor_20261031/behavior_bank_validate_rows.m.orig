function B=behavior_bank_validate_rows(versions,records,v,m)
%BEHAVIOR_BANK_VALIDATE_ROWS Verify public selected RX/Bank event alignment.
% v and m are already exact-time sampled valid1/meta9; no P/ADC truth/ref.
    assert(isnumeric(versions)&&isreal(versions)&&isequal(size(versions),[1 2])&& ...
        all(isfinite(versions))&&all(versions==floor(versions))&&versions(1)>=1&&versions(1)<versions(2), ...
        'bankRecord:versions','Use the two applied increasing public version IDs.');
    assert(isstruct(records)&&isscalar(records)&& ...
        isequal(sort(fieldnames(records)),sort({'raw';'time_s'}))&& ...
        isa(records.raw,'double')&&isreal(records.raw)&&size(records.raw,2)==6&& ...
        isa(records.time_s,'double')&&isreal(records.time_s)&&iscolumn(records.time_s)&& ...
        size(records.raw,1)==numel(records.time_s)&&~isempty(records.time_s)&& ...
        all(isfinite(records.time_s))&&all(diff(records.time_s)>0), ...
        'bankRecord:records','Nonempty ordered public RAW6/time required.');
    r=records.raw;n=size(r,1);
    assert(isa(v,'double')&&isreal(v)&&isequal(size(v),[n 1])&& ...
        isa(m,'double')&&isreal(m)&&isequal(size(m),[n 9]), ...
        'bankRecord:shape','Exact sampled valid1/meta9 dimensions required.');
    assert(all(r(:,6)==1)&&all(v==1)&&all(m(:,3)==r(:,4))&&all(m(:,4)==r(:,5))&& ...
        all(m(:,5)==r(:,6))&&all(m(:,8)==0)&&all(m(:,2)==records.time_s)&& ...
        all(ismember(m(:,6),[1 2])),'bankRecord:join', ...
        'Actual valid/tag/fault does not match the selected RX record.');
    slot=m(:,6);expected=reshape(versions(slot),[],1);
    assert(all(m(:,7)==expected),'bankRecord:version','Actual selected version differs from applied slot.');
    B=struct('valid',v,'slot',slot,'version',m(:,7),'scope','behavior_only_not_product_acceptance');
end
