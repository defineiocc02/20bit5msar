 function P=behavior_dac_coupling_configuration(P,enabled)
 %BEHAVIOR_DAC_COUPLING_CONFIGURATION Bind immutable FE driving metadata only.
-% Candidate call after frontend normalization. Does not enable/modify tau_dac,
-% states, graph, event calendar or current prepare's finite-DAC rejection.
+% Called by prepare after FE normalization; binds enabled, tau[18], schema and plan.
+% Does not alter FE tau/state, the graph or the event calendar.
 % No C truth is copied; public plan preserves the FE reduction order.
     assert(isscalar(enabled)&&isreal(enabled)&&ismember(enabled,[0 1]), ...
         'behaviorDAC:enabled','Use one explicit logical coupling flag.');
--- a/current/src/physics/behavior_backend_stage.m
+++ b/current/src/physics/behavior_backend_stage.m
@@ -8,8 +8,9 @@
 % Advance ignores NEW command and advances only the command in the incoming
 % state. Commit requires eventTime==state.time_s and applies NEW command at dt0.
 % Both blocks represent successive transforms of ONE state, not two memories.
-% Candidate optional oldFrontend353 is read ONLY in finite-DAC active advance;
-% off/all-zero tau retains the original backend_step call/operations.
+% Sfun supplies OLD FE353 for enabled/nonzero-tau advance, even when RA is off.
+% The stage builds forcing only when the retained RA is on and not reset.
+% Off/all-zero tau retains the original backend_step call/operations.
     assert((ischar(kind)&&isrow(kind))||(isstring(kind)&&isscalar(kind)), ...
         'behavior:stageKind','Stage kind must be advance or commit.');
     kind=char(kind);
